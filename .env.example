SECURITY_STORAGE=postgres
# Supabase dashboard > Connect > Session pooler > URI. Replace the password.
DATABASE_URL=
PORT=3000
# Optional: absolute path to the Supabase server CA certificate downloaded from the dashboard.
# PGSSLROOTCERT=C:/path/to/supabase-ca.crt

# Application origin used in account email links (required HTTPS when NODE_ENV=production).
PUBLIC_ORIGIN=http://localhost:3000
# Development preview writes emails to data/mail; real delivery requires smtp.
MAIL_MODE=preview
# MAIL_MODE=smtp
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Aikrhis <no-reply@your-domain.com>
